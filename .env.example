# ---------------------------------------------------------------------------
# whatsapp-guest-concierge — environment
# Copy to .env and fill in. Everything below has a safe default in DEMO_MODE.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Master switch: boots with in-memory fakes for every external service, so the
# app runs with zero credentials.
DEMO_MODE=true

# Per-integration overrides. Each defaults to DEMO_MODE. Use these to bring one
# integration live before you have credentials for the others, e.g. test a real
# Twilio number against a mocked calendar:
#   DEMO_MODE=false
#   CALENDAR_DEMO=true
#   LLM_DEMO=true
# TWILIO_DEMO=
# CALENDAR_DEMO=
# LLM_DEMO=

# Public URL this service is reachable at. MUST match exactly what Twilio calls,
# including protocol — Twilio signature validation depends on it.
PUBLIC_URL=http://localhost:3000

# SQLite file. Created on first boot.
DATABASE_PATH=./data/concierge.db

# --- LLM ---------------------------------------------------------------------
# anthropic | openai | gemini | mock
# Switching provider is a config change only. Set the matching key below.
LLM_PROVIDER=anthropic

# Optional. Overrides the provider default:
#   anthropic -> claude-opus-5    (the brief named a Sonnet-class model;
#                                  use claude-sonnet-5 to match)
#   openai    -> gpt-5.6-terra
#   gemini    -> gemini-3.7-flash
LLM_MODEL=
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.3
# Safety valve on the tool-use loop.
LLM_MAX_TOOL_ITERATIONS=5

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Twilio WhatsApp --------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sandbox default is whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Set false only when testing locally without a tunnel. Never in production.
TWILIO_VALIDATE_SIGNATURE=true

# --- Google Calendar --------------------------------------------------------
# Path to the service-account JSON, or paste the JSON into the _JSON variable.
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SERVICE_ACCOUNT_JSON=
# The calendar must be shared with the service-account email address.
GOOGLE_CALENDAR_ID=
CALENDAR_TIMEZONE=Europe/Istanbul

# --- Knowledge base ---------------------------------------------------------
# local | notion | google-doc
KB_PROVIDER=local
KB_LOCAL_PATH=./kb
KB_REFRESH_CRON=0 4 * * *

NOTION_API_KEY=
NOTION_PAGE_ID=

GOOGLE_DOC_ID=

# --- Admin ------------------------------------------------------------------
# Bearer token for /admin/* and the dashboard.
ADMIN_API_TOKEN=change-me
# Comma-separated E.164 numbers allowed to run ! commands over WhatsApp.
ADMIN_PHONE_NUMBERS=

# --- Limits -----------------------------------------------------------------
BROADCAST_CONCURRENCY=5
BROADCAST_MAX_ATTEMPTS=3
GUEST_RATE_LIMIT_PER_MINUTE=10
CONVERSATION_HISTORY_TURNS=8
