# Internal working notes — never published
.project/

# Environment & secrets
.env
.env.*
!.env.example
*.pem

# Google service-account keys. GCP downloads these as <project>-<12 hex>.json,
# which no "credentials"-shaped glob would catch — so ignore that shape directly
# and keep a wholly-ignored directory for anything else secret.
secrets/
*service-account*.json
google-credentials.json
gcp-*.json
*-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f].json

# Data
data/
*.db
*.db-journal
*.sqlite
*.sqlite3

# Build output
dist/
build/
*.tsbuildinfo

# Dependencies
node_modules/
.pnp
.pnp.js

# Test & coverage
coverage/
.nyc_output/

# Logs
logs/
*.log
npm-debug.log*
yarn-error.log*

# Editor / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Tooling caches
.eslintcache
.cache/
