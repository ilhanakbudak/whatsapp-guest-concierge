{
  "name": "whatsapp-guest-concierge",
  "version": "0.1.0",
  "description": "WhatsApp AI concierge for private holiday groups — Twilio + Claude + Google Calendar, with a durable broadcast system.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "seed": "tsx scripts/seed-demo.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "smoke": "node scripts/smoke.mjs",
    "verify": "bash scripts/verify.sh",
    "check:calendar": "tsx scripts/check-calendar.ts",
    "check:llm": "tsx scripts/check-llm.ts",
    "setup:calendar": "tsx scripts/setup-calendar.ts",
    "check:twilio": "tsx scripts/check-twilio.ts",
    "simulate": "tsx scripts/simulate-inbound.ts",
    "screenshots": "node scripts/screenshot.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.121.0",
    "@fastify/formbody": "^9.0.0",
    "@fastify/static": "^10.1.3",
    "@google/genai": "^2.19.0",
    "@googleapis/calendar": "^16.0.0",
    "@googleapis/docs": "^10.0.0",
    "@notionhq/client": "^5.1.0",
    "better-sqlite3": "^12.2.0",
    "dotenv": "^17.2.0",
    "fastify": "^5.4.0",
    "node-cron": "^4.2.0",
    "openai": "^7.7.0",
    "pino": "^9.7.0",
    "twilio": "^5.7.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "eslint": "^9.33.0",
    "globals": "^17.11.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.39.0",
    "vitest": "^3.2.0"
  }
}
