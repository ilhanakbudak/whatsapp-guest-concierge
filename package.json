{
  "name": "whatsapp-guest-concierge",
  "version": "0.1.0",
  "description": "WhatsApp AI concierge for private holiday groups — Twilio + Claude + Google Calendar, with a durable broadcast system.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "seed": "tsx scripts/seed-demo.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.65.0",
    "@notionhq/client": "^5.1.0",
    "better-sqlite3": "^12.2.0",
    "dotenv": "^17.2.0",
    "fastify": "^5.4.0",
    "google-auth-library": "^10.1.0",
    "googleapis": "^160.0.0",
    "node-cron": "^4.2.0",
    "pino": "^9.7.0",
    "twilio": "^5.7.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "eslint": "^9.33.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.39.0",
    "vitest": "^3.2.0"
  }
}
