# Everything the image does not need. Keeping this tight is what makes the
# build context small and the layer cache useful.
.git
.github
.project
node_modules
dist
data
coverage

# Never let credentials into an image layer.
.env
.env.*
!.env.example
secrets/
*.pem
google-credentials.json

# Not needed at runtime
tests
scripts
docs
examples
n8n
*.md
!README.md
.eslintcache
.vscode
.idea
.DS_Store
